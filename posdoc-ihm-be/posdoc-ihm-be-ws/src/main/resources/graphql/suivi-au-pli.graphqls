    zoncli: String
    dplidc: String
    dplidd: String
    dplidt: String
    dplide: String
    dplidh: String
    nbpage: String
    nbfeui: String
    edtype: String
    poipli: String
    coupli: String
    idtpli: String
    codpos: String
    codpay: String
    adres1: String
    adres2: String
    adres3: String
    adres4: String
    adres5: String
    adres6: String
    adres7: String
    expad1: String
    expad2: String
    expad3: String
    expad4: String
    genpro: String
    infcl1: String
    infcl2: String
    datdep: String
    mpsidd: String
    status: String
    cominf: String
    codgam: String
    prosta: String
