extend type Query {
    searchPliByQuery(query: SearchPliQueryInput): [SearchPliResult]
    searchPliByNumpli(numpli: String): SuiviAuPliDetailResult
}

input SearchPliQueryInput {
    dtdeb: String
    dtfin: String
    numpli: String
    idtpli: String
    adress: String
    isCnav: Boolean
}

type SearchPliResult {
    status: String
    numpli: String
    idtpli: String
    genpro: String
    adres1: String
    adres2: String
    adres3: String
    adres4: String
    adres5: String
    adres6: String
    adres7: String
    codgam: String
    mpsidd: String
    datdep: String
}

type SuiviAuPliDetailResult {
    numpli: String
    codenv: String
    codorg: String
    codapp: String
    percod: String
    codcom: String
    codfic: String
    numcom: String
