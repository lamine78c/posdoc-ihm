{
  "name": "posdoc-fe-ihm",
  "version": "0.0.1",
  "date": "empty",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --configuration production --base-href=/posdoc_fe_ihm/",
    "build-prod-pfs": "ng build --configuration production",
    "prepare-dist": "cp package.json dist/posdoc-fe-ihm",
    "preparedist-pfs": "npm run build-prod-pfs && cp package.json dist/posdoc-fe-ihm/ && cp README.md dist/posdoc-fe-ihm/ && cp CHANGELOG.md dist/posdoc-fe-ihm",
    "build-prod-targz": "npm run preparedist && cd ./dist/posdoc-fe-ihm/ && tar -czvf ../posdoc_fe_ihm.tar.gz *",
    "build-prod-targz-pfs": "npm run preparedist-pfs && cd ./dist/posdoc-fe-ihm/ && tar -czvf ../posdoc_fe_ihm.tar.gz *",
    "publish-dist": "npm run prepare-dist && cd dist/posdoc-fe-ihm && tar -czvf ../posdoc_fe_ihm.tar.gz `ls -A -1` && npm publish",
    "publish-dist-pfs": "npm run preparedist-pfs && cd dist/posdoc-fe-ihm && npm publish --registry=http://nexus.urssaf.recouv/repository/npm-hosted/",
    "test": "ng test --code-coverage --browsers=Chrome",
    "test-dev": "ng test --karma-config=karma.dev.conf.js --watch=true --source-map=true",
    "test-ci": "ng test --code-coverage --browsers=ChromeHeadless",
    "e2e": "ng serve & npx playwright test",
    "update-date": "node update-date.js"
  },
