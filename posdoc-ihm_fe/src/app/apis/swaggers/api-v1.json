  "paths": {
    "/entreprises": {
      "get": {
        "tags": ["Entreprise"],
        "summary": "Rechercher parmi les entreprises",
        "operationId": "RechercherEntreprises",
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "query",
            "type":"string",
            "name": "denomination",
            "description": "Dénomination de l'entreprise",
            "required": false
          },
          {
            "in": "query",
            "type":"string",
            "name": "cp",
            "description": "Code Postal de l'entreprise",
            "required": false
          },
          {
            "in": "query",
            "type":"array",
            "items" : {
              "type": "string"
            },
            "name": "sort",
            "description": "Criteres de tri",
            "required": false
          },
          {
            "in": "query",
            "type":"integer",
            "name": "currentPage",
            "description": "page courante",
            "required": false
          },
          {
            "in": "query",
            "type":"integer",
            "name": "size",
            "description": "Nombre d'éléments demandés",
            "required": false
          },
          {
            "in": "query",
            "type":"boolean",
            "name": "simple",
            "description": "Indicateur pour ne retourner que les champs simples ou l'objet complet",
            "required": false,
            "default": true
          }
        ],
        "responses": {
          "200": {
            "description": "Recherche effectuée",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EntrepriseType"
              }
            }
          },
          "400": {
            "description": "Requête incorrecte ou erreur fonctionnelle lors de la recherche"
          },
          "401": {
            "description": "Token d'authentification absent ou invalide"
          }
        }
      },
      "post": {
        "tags": ["Entreprise"],
        "summary": "Créer une entreprise",
        "operationId": "CreerEntreprise",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "entreprise",
            "description": "Données de l'entreprise",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EntrepriseType"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Création effectuée",
            "schema": {
              "$ref": "#/definitions/ResultatCreationType"
            }
          },
          "400": {
            "description": "Erreur fonctionnelle lors de la création"
          },
          "401": {
            "description": "Token d'authentification absent ou invalide"
          }
        }
      }
    },
