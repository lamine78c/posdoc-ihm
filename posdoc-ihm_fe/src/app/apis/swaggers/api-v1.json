  "definitions": {
    "EntrepriseType": {
      "type": "object",
      "properties": {
        "dateCreation": {
          "type": "string",
          "format": "date-time",
          "description": "Date de création"
        },
        "dateMaj": {
          "type": "string",
          "format": "date-time",
          "description": "Date de dernière mise à jour (obligatoire pour les services de maj)"
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Identifiant de l'adresse",
          "example": "1"
        },
        "siren": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "description": "Numéro SIREN de l'entreprise",
          "example": "123456789"
        },
        "denomination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Dénomination de l'entreprise",
          "example": "Mon entreprise"
        },
        "activite": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Activité principale de l'entreprise",
          "example": "Prestations informatiques"
        },
        "naf": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4,
          "description": "Code NAF de l'entreprise",
          "example": "095A"
        },
        "adresses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AdresseType"
          },
          "description": "Adresses de l'entreprise"
        }
      }
    },
    "AdresseType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Identifiant de l'adresse",
          "example": "1"
        },
        "ligne1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Première ligne de l'adresse",
          "example": "Immeuble le président"
        },
        "ligne2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Seconde ligne de l'adresse",
          "example": "36 rue de Valmy"
        },
        "commune": {
          "$ref": "#/definitions/CommuneType"
        }
      }
    },
    "CommuneType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Identifiant de la commune",
          "example": "1"
        },
        "cp": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "description": "Code Postal",
          "example": "93108"
        },
        "nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Nom",
          "example": "Montreuil"
        }
      }
    },
    "ResultatCreationType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Identifiant de l'objet créé'",
          "example": "1"
        }
      }
    },
    "ErreurType": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Code de l'erreur",
          "example": "ENTR_INEXISTANTE"
        },
