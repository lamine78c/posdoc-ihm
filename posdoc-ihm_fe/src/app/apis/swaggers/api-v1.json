{
  "swagger": "2.0",
  "info": {
    "description": "Application Fullstack exposant des services REST, réalisée dans le cadre d'un groupe de travail du Bureau Technique des E&D.",
    "version": "1.0",
    "title": "Application Fullstack REST",
    "contact": {
      "name": "Bureau Technique E&D",
      "url": "http://techniques.renov.recouv/doku.php?id=bureau_technique_ed:start"
    }
  },
  "basePath": "/fullstack_be/v1",
  "securityDefinitions": {
    "prismeHeader": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  },
  "security":[{
    "prismeHeader":[]
  }],
  "tags": [{
      "name": "Entreprise",
      "description": "Operations concernant les entreprises"
    },{
      "name": "Commune",
      "description": "Operations concernant les communes"
    },{
      "name": "Erreurs",
      "description": "Operations permettant de tester les différents types d'exceptions remontées par l'application blanche"
