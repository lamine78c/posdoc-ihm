      "delete": {
        "tags": ["Entreprise"],
        "summary": "Supprimer une entreprise",
        "operationId": "SupprimerEntreprise",
        "produces": ["application/json"],
        "parameters": [{
            "name": "idEntreprise",
            "in": "path",
            "description": "Identifiant de l'entreprise",
